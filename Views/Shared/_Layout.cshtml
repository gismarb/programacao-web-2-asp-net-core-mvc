<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Projeto1_IF</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projeto1_IF.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Projeto1_IF</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <ul class="navbar-nav flex-grow-1">
                        @*
                            Gismar Pereira Barbosa

                            Menu principal ajustado para facilitar a navegação conforme
                            o perfil do usuário autenticado.

                            Observação técnica:
                            Esta navegação por Role melhora a experiência de uso, mas não
                            substitui a segurança aplicada nos Controllers com [Authorize]
                            e filtros LINQ.
                        *@

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-area=""
                            asp-controller="Home"
                            asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-area=""
                            asp-controller="Home"
                            asp-action="Privacy">
                                Privacidade
                            </a>
                        </li>

                        @if (!User.Identity?.IsAuthenticated ?? true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="Profissionais"
                                asp-action="RegistrarMedico">
                                    Registrar Médico
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="Profissionais"
                                asp-action="RegistrarNutricionista">
                                    Registrar Nutricionista
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Medico") || User.IsInRole("Nutricionista"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="Profissionais"
                                asp-action="MeusDados">
                                    Meus Dados
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="Profissionais"
                                asp-action="MeusPacientes">
                                    Meus Pacientes
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("GerenteMedico") ||
                            User.IsInRole("GerenteNutricionista") ||
                            User.IsInRole("GerenteGeral"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                asp-area=""
                                asp-controller="Profissionais"
                                asp-action="Gerenciar">
                                    Gerenciar Profissionais
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">

        <main role="main" class="pb-3">
            @*
                Gismar Pereira Barbosa

                Bloco criado para exibir mensagens gerais da aplicação
                usando TempData.

                Justificativa técnica:
                Algumas actions redirecionam após operações de cadastro, edição
                ou exclusão. O TempData permite transportar mensagens entre uma
                requisição e outra, exibindo alertas Bootstrap após o redirect.
            *@

            @if (TempData["MensagemSucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["MensagemSucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["MensagemErro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Projeto1_IF - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
