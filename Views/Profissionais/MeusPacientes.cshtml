@model IEnumerable<Projeto1_IF.ViewModels.PacienteProfissionalViewModel>

@{
    ViewData["Title"] = "Meus pacientes";
}

@*
    Gismar Pereira Barbosa

    View criada para listar os pacientes vinculados ao profissional logado.

    Justificativa técnica:
    Esta tela recebe uma coleção de PacienteProfissionalViewModel,
    e não o model TbPaciente diretamente.

    A filtragem dos pacientes é feita no Controller, a partir do IdUser
    do usuário autenticado e do vínculo existente em tbMedico_Paciente.

    A View apenas exibe os pacientes que já foram autorizados pela consulta
    da action MeusPacientes.
*@

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Lista de pacientes vinculados ao seu cadastro profissional.
</p>

<hr />

<p>
    <a asp-action="CriarMeuPaciente" class="btn btn-primary">
        Cadastrar novo paciente
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum paciente vinculado ao seu cadastro profissional.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>RG</th>
                    <th>Nascimento</th>
                    <th>Sexo</th>
                    <th>Cidade</th>
                    <th>Celular</th>
                    <th>Informação resumida</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Cpf</td>
                        <td>@item.Rg</td>
                        <td>@item.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>@item.Sexo</td>
                        <td>@item.Cidade</td>
                        <td>@item.TelCelular</td>
                        <td>@item.InformacaoResumida</td>
                        <td class="text-end">
                            <a asp-action="MeuPacienteDetails"
                               asp-route-id="@item.IdPaciente"
                               class="btn btn-sm btn-outline-primary">
                                Detalhes
                            </a>

                            <a asp-action="EditarMeuPaciente"
                               asp-route-id="@item.IdPaciente"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>

                            <a asp-action="ExcluirMeuPaciente"
                               asp-route-id="@item.IdPaciente"
                               class="btn btn-sm btn-outline-danger">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}