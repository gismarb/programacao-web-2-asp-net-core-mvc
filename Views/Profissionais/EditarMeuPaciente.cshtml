@model Projeto1_IF.ViewModels.EditarMeuPacienteViewModel

@{
    ViewData["Title"] = "Editar paciente";
}

@*
    Gismar Pereira Barbosa

    View criada para permitir a edição de paciente vinculado
    ao profissional logado.

    Justificativa técnica:
    Esta tela utiliza EditarMeuPacienteViewModel porque a edição envolve
    dados de tbPaciente e também a Informação Resumida armazenada em
    tbMedico_Paciente.

    O IdProfissional não é recebido pela View. A autorização é validada
    no Controller a partir do usuário autenticado e do vínculo existente
    entre profissional e paciente.
*@

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Atualize os dados do paciente vinculado ao seu cadastro profissional.
</p>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="EditarMeuPaciente" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="IdPaciente" />
            <input type="hidden" asp-for="IdMedicoPaciente" />

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Dados principais</strong>
                </div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Nome" class="control-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Rg" class="control-label"></label>
                        <input asp-for="Rg" class="form-control" />
                        <span asp-validation-for="Rg" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Cpf" class="control-label"></label>
                        <input asp-for="Cpf" class="form-control" />
                        <span asp-validation-for="Cpf" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="DataNascimento" class="control-label"></label>
                        <input asp-for="DataNascimento" class="form-control" type="date" />
                        <span asp-validation-for="DataNascimento" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Sexo" class="control-label"></label>
                        <select asp-for="Sexo" class="form-control">
                            <option value="">Selecione</option>
                            <option value="M">Masculino</option>
                            <option value="F">Feminino</option>
                            <option value="O">Outro</option>
                        </select>
                        <span asp-validation-for="Sexo" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Etnia" class="control-label"></label>
                        <select asp-for="Etnia" class="form-control">
                            <option value="">Selecione</option>
                            <option value="1">Branca</option>
                            <option value="2">Preta</option>
                            <option value="3">Parda</option>
                            <option value="4">Amarela</option>
                            <option value="5">Indígena</option>
                            <option value="6">Não informado</option>
                        </select>
                        <span asp-validation-for="Etnia" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NomeResponsavel" class="control-label"></label>
                        <input asp-for="NomeResponsavel" class="form-control" />
                        <span asp-validation-for="NomeResponsavel" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Profissao" class="control-label"></label>
                        <input asp-for="Profissao" class="form-control" />
                        <span asp-validation-for="Profissao" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Endereço</strong>
                </div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Endereco" class="control-label"></label>
                        <input asp-for="Endereco" class="form-control" />
                        <span asp-validation-for="Endereco" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Bairro" class="control-label"></label>
                        <input asp-for="Bairro" class="form-control" />
                        <span asp-validation-for="Bairro" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="IdCidade" class="control-label"></label>
                        <select asp-for="IdCidade" class="form-control" asp-items="Model.Cidades">
                            <option value="">Selecione uma cidade</option>
                        </select>
                        <span asp-validation-for="IdCidade" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Contato</strong>
                </div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="TelResidencial" class="control-label"></label>
                        <input asp-for="TelResidencial" class="form-control" />
                        <span asp-validation-for="TelResidencial" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TelComercial" class="control-label"></label>
                        <input asp-for="TelComercial" class="form-control" />
                        <span asp-validation-for="TelComercial" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TelCelular" class="control-label"></label>
                        <input asp-for="TelCelular" class="form-control" />
                        <span asp-validation-for="TelCelular" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Informações complementares</strong>
                </div>

                <div class="card-body">
                    <div class="form-check mb-3">
                        <input asp-for="FlgAtleta" class="form-check-input" />
                        <label asp-for="FlgAtleta" class="form-check-label"></label>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="FlgGestante" class="form-check-input" />
                        <label asp-for="FlgGestante" class="form-check-label"></label>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="InformacaoResumida" class="control-label"></label>
                        <textarea asp-for="InformacaoResumida" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="InformacaoResumida" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Salvar alterações" class="btn btn-primary" />

                <a asp-action="MeuPacienteDetails"
                   asp-route-id="@Model.IdPaciente"
                   class="btn btn-secondary">
                    Cancelar
                </a>

                <a asp-action="MeusPacientes" class="btn btn-outline-secondary">
                    Voltar para meus pacientes
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}