@model Projeto1_IF.ViewModels.EditarProfissionalGerencialViewModel

@{
    ViewData["Title"] = "Editar profissional";
}

@*
    Gismar Pereira Barbosa

    View criada para edição gerencial de profissionais.

    Justificativa técnica:
    Esta tela utiliza EditarProfissionalGerencialViewModel para controlar
    quais campos podem ser alterados pelo gerente.

    Diferente da tela EditarMeusDados, o CPF fica disponível para edição,
    pois o requisito do trabalho permite que gerentes alterem o CPF
    do profissional.

    A validação de permissão não fica nesta View. O Controller valida
    se o gerente logado pode editar o tipo profissional selecionado.
*@

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Edição gerencial do cadastro de <strong>@Model.TipoProfissionalNome</strong>.
</p>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="GerenciarEdit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="IdProfissional" />
            <input type="hidden" asp-for="IdTipoProfissional" />
            <input type="hidden" asp-for="TipoProfissionalNome" />

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Dados principais</strong>
                </div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Tipo profissional</label>
                        <input value="@Model.TipoProfissionalNome" class="form-control" readonly />
                        <small class="form-text text-muted">
                            O tipo profissional não é alterado nesta tela.
                        </small>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Nome" class="control-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Cpf" class="control-label"></label>
                        <input asp-for="Cpf" class="form-control" />
                        <span asp-validation-for="Cpf" class="text-danger"></span>
                        <small class="form-text text-muted">
                            O CPF pode ser alterado somente por usuários gerenciais autorizados.
                        </small>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CrmCrn" class="control-label"></label>
                        <input asp-for="CrmCrn" class="form-control" />
                        <span asp-validation-for="CrmCrn" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Especialidade" class="control-label"></label>
                        <input asp-for="Especialidade" class="form-control" />
                        <span asp-validation-for="Especialidade" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Endereço</strong>
                </div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Logradouro" class="control-label"></label>
                        <input asp-for="Logradouro" class="form-control" />
                        <span asp-validation-for="Logradouro" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Numero" class="control-label"></label>
                        <input asp-for="Numero" class="form-control" />
                        <span asp-validation-for="Numero" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Bairro" class="control-label"></label>
                        <input asp-for="Bairro" class="form-control" />
                        <span asp-validation-for="Bairro" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Cep" class="control-label"></label>
                        <input asp-for="Cep" class="form-control" />
                        <span asp-validation-for="Cep" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="IdCidade" class="control-label"></label>
                        <select asp-for="IdCidade" class="form-control" asp-items="Model.Cidades">
                            <option value="">Selecione uma cidade</option>
                        </select>
                        <span asp-validation-for="IdCidade" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Contato</strong>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <label asp-for="Ddd1" class="control-label"></label>
                                <input asp-for="Ddd1" class="form-control" />
                                <span asp-validation-for="Ddd1" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="form-group mb-3">
                                <label asp-for="Telefone1" class="control-label"></label>
                                <input asp-for="Telefone1" class="form-control" />
                                <span asp-validation-for="Telefone1" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group mb-3">
                                <label asp-for="Ddd2" class="control-label"></label>
                                <input asp-for="Ddd2" class="form-control" />
                                <span asp-validation-for="Ddd2" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-9">
                            <div class="form-group mb-3">
                                <label asp-for="Telefone2" class="control-label"></label>
                                <input asp-for="Telefone2" class="form-control" />
                                <span asp-validation-for="Telefone2" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Salvar alterações" class="btn btn-primary" />

                <a asp-action="GerenciarDetails"
                   asp-route-id="@Model.IdProfissional"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}