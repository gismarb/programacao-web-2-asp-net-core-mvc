@model IEnumerable<Projeto1_IF.ViewModels.ProfissionalGerencialViewModel>

@{
    ViewData["Title"] = ViewData["TituloGerencial"] ?? "Gerenciamento de Profissionais";
}

@*
    Gismar Pereira Barbosa

    View criada para listar profissionais na área gerencial.

    Justificativa técnica:
    Esta tela recebe uma coleção de ProfissionalGerencialViewModel,
    e não o model TbProfissional diretamente.

    O Controller aplica os filtros por Role antes de enviar os dados
    para a View:
    - GerenteMedico visualiza somente médicos;
    - GerenteNutricionista visualiza somente nutricionistas;
    - GerenteGeral visualiza todos os profissionais.

    A View apenas exibe os dados já autorizados pelo Controller.
*@

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Lista de profissionais disponível conforme o perfil gerencial do usuário logado.
</p>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum profissional encontrado para o seu perfil de acesso.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Tipo</th>
                    <th>CRM/CRN</th>
                    <th>Especialidade</th>
                    <th>Cidade</th>
                    <th>E-mail</th>
                    <th>Plano</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nome</td>
                        <td>@item.Cpf</td>
                        <td>@item.TipoProfissional</td>
                        <td>@item.CrmCrn</td>
                        <td>@item.Especialidade</td>
                        <td>@item.Cidade</td>
                        <td>@item.EmailUsuario</td>
                        <td>@item.Plano</td>
                        <td class="text-end">
                            <a asp-action="GerenciarDetails"
                               asp-route-id="@item.IdProfissional"
                               class="btn btn-sm btn-outline-primary">
                                Detalhes
                            </a>

                            <a asp-action="GerenciarEdit"
                               asp-route-id="@item.IdProfissional"
                               class="btn btn-sm btn-outline-secondary">
                                Editar
                            </a>

                            <a asp-action="GerenciarDelete"
                               asp-route-id="@item.IdProfissional"
                               class="btn btn-sm btn-outline-danger">
                                Excluir
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}