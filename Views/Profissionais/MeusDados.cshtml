@model Projeto1_IF.Models.TbProfissional

@{
    ViewData["Title"] = "Meus dados profissionais";
}

@*
    Gismar Pereira Barbosa

    View criada para exibir os dados do profissional logado.

    Justificativa técnica:
    Esta tela não recebe IdProfissional pela URL.
    O Controller carrega os dados com base no IdUser do usuário autenticado
    no ASP.NET Core Identity.

    Isso impede que um Médico ou Nutricionista visualize dados de outro
    profissional apenas manipulando parâmetros de rota.
*@

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Consulte abaixo os dados vinculados ao seu usuário profissional.
</p>

<hr />

<div class="card mb-4">
    <div class="card-header">
        <strong>Dados principais</strong>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3">CPF</dt>
            <dd class="col-sm-9">@Model.Cpf</dd>

            <dt class="col-sm-3">Tipo profissional</dt>
            <dd class="col-sm-9">
                @{
                    var tipoProfissional = Model.IdTipoProfissional == 1
                        ? "Médico"
                        : Model.IdTipoProfissional == 2
                            ? "Nutricionista"
                            : "Não identificado";
                }

                @tipoProfissional
            </dd>

            <dt class="col-sm-3">CRM/CRN</dt>
            <dd class="col-sm-9">@Model.CrmCrn</dd>

            <dt class="col-sm-3">Especialidade</dt>
            <dd class="col-sm-9">@Model.Especialidade</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Contrato</strong>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Plano</dt>
            <dd class="col-sm-9">@Model.IdContratoNavigation?.IdPlanoNavigation?.Nome</dd>

            <dt class="col-sm-3">Início</dt>
            <dd class="col-sm-9">@Model.IdContratoNavigation?.DataInicio?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Fim</dt>
            <dd class="col-sm-9">@Model.IdContratoNavigation?.DataFim?.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Endereço</strong>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Logradouro</dt>
            <dd class="col-sm-9">@Model.Logradouro</dd>

            <dt class="col-sm-3">Número</dt>
            <dd class="col-sm-9">@Model.Numero</dd>

            <dt class="col-sm-3">Bairro</dt>
            <dd class="col-sm-9">@Model.Bairro</dd>

            <dt class="col-sm-3">CEP</dt>
            <dd class="col-sm-9">@Model.Cep</dd>

            <dt class="col-sm-3">Cidade</dt>
            <dd class="col-sm-9">@Model.IdCidadeNavigation?.Nome</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>Contato</strong>
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Telefone principal</dt>
            <dd class="col-sm-9">(@Model.Ddd1) @Model.Telefone1</dd>

            <dt class="col-sm-3">Telefone secundário</dt>
            <dd class="col-sm-9">(@Model.Ddd2) @Model.Telefone2</dd>
        </dl>
    </div>
</div>

<div>
    <a asp-action="EditarMeusDados" class="btn btn-primary">Editar meus dados</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>